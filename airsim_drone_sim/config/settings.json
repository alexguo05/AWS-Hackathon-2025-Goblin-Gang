{
  "simulation": {
    "drone_name": "Drone1",
    "simulation_time": 60,
    "data_collection_interval": 0.1,
    "max_altitude": 100,
    "min_altitude": 10,
    "max_speed": 20
  },
  "camera": {
    "front_camera": {
      "enabled": true,
      "image_type": "Scene",
      "pixels_as_float": false,
      "compress": true
    },
    "depth_camera": {
      "enabled": true,
      "image_type": "DepthVis",
      "pixels_as_float": false,
      "compress": true
    }
  },
  "data_storage": {
    "base_path": "./data",
    "save_images": true,
    "save_telemetry": true,
    "image_format": "png",
    "telemetry_format": "csv"
  },
  "flight_patterns": {
    "hover": {
      "duration": 5,
      "altitude": 20
    },
    "circle": {
      "radius": 50,
      "altitude": 30,
      "speed": 10
    },
    "waypoint": {
      "points": [
        {"x": 0, "y": 0, "z": -20},
        {"x": 50, "y": 0, "z": -20},
        {"x": 50, "y": 50, "z": -20},
        {"x": 0, "y": 50, "z": -20},
        {"x": 0, "y": 0, "z": -20}
      ]
    }
  }
}
