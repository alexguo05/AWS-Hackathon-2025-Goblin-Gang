# AirSim Configuration
# Copy this file to .env and modify as needed

# AirSim connection settings
AIRSIM_HOST=127.0.0.1
AIRSIM_PORT=41451

# Data collection settings
DATA_COLLECTION_INTERVAL=0.1
SAVE_IMAGES=true
SAVE_TELEMETRY=true

# Logging settings
LOG_LEVEL=INFO
LOG_TO_FILE=true

# Simulation settings
DEFAULT_FLIGHT_PATTERN=waypoint
SIMULATION_TIMEOUT=300
