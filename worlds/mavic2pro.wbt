WorldInfo {
  info [
    "Dense urban center (400m x 400m) with realistic density gradient."
    "Downtown core with high density, suburban periphery with lower density."
  ]
  title "Dense Urban Center Drone Mapping"
  basicTimeStep 35
  defaultDamping Damping {
    linear 0.5
    angular 0.5
  }
}
Viewpoint {
  orientation -0.020062233686350364 -0.008707497766162033 0.999760814526238 3.221690972687593
  position 2.3972764711488423 0.10756152378932171 0.5141749630763428
  near 0.2
  followSmoothness 0.2
}
TexturedBackground {
  luminosity 3
}
TexturedBackgroundLight {
}
Floor {
  size 400 400  # Original size
  tileSize 6 6
  appearance SandyGround {
  }
}

